{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  // .nuxt/tsconfig.json only excludes dist and .output, so the electron bundles and the .diagcheck
  // output of `npm run check` were being type-checked as source. Declaring exclude here replaces
  // the inherited list, hence dist/.output are repeated.
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    ".output",
    ".release",
    ".diagcheck",
    "static",
    "public"
  ],
  "ts-node": {
    "compilerOptions": {
      "target": "ES2018",
      "module": "commonjs",
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "lib": ["ESNext", "ESNext.AsyncIterable", "DOM"],
      "esModuleInterop": true,
      "allowJs": true,
      "sourceMap": true,
      "strict": false,
      "noEmit": true,
      "baseUrl": ".",
      "jsx": "preserve",
      "moduleResolution": "node"
    },
    "transpileOnly": true
  }
}
