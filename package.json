{
  "name": "NR-Editor",
  "private": true,
  "description": "New Recruit Data Editor",
  "author": "New Recruit",
  "version": "1.4.19",
  "main": "main.js",
  "scripts": {
    "build": "nuxt generate --electron",
    "buildelectron": "npm run build && npm exec electron-builder",
    "buildelectron:publish": "npm run build && npm exec electron-builder --publish=always",
    "buildweb": "nuxt build",
    "dev": "nuxi dev --port 3005",
    "start": "nuxi start",
    "generate": "nuxi generate",
    "preview": "electron dist",
    "postinstall": "nuxt prepare",
    "electron": "npx nuxi generate --electron && node scripts/run-electron.cjs",
    "deploy": "nuxi generate --ghpages && gh-pages -d dist -t true",
    "increment-version": "npm version patch --force",
    "lint": "eslint . --quiet",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:fix": "npm run lint:fix",
    "typecheck:ts": "tsc -p tsconfig.typecheck.json --noEmit",
    "check": "tsc assets/editor/bs_diagnostics_engine.ts assets/editor/bs_diagnostics_check.ts assets/editor/bs_reference_index.ts assets/editor/bs_reference_index_check.ts stores/field_edit_stack.ts stores/field_edit_stack_check.ts stores/open_state.ts stores/open_state_check.ts assets/editor/bs_link_cycles.ts assets/editor/bs_link_cycles_check.ts assets/editor/bs_initialize.ts assets/editor/bs_initialize_check.ts --ignoreConfig --outDir .diagcheck --module node16 --target es2020 --moduleResolution node16 --types node --skipLibCheck && node .diagcheck/assets/editor/bs_diagnostics_check.js && node .diagcheck/assets/editor/bs_reference_index_check.js && node .diagcheck/stores/field_edit_stack_check.js && node .diagcheck/stores/open_state_check.js && node .diagcheck/assets/editor/bs_link_cycles_check.js && node .diagcheck/assets/editor/bs_initialize_check.js"
  },
  "build": {
    "appId": "nr-editor",
    "productName": "NewRecruit Editor",
    "directories": {
      "output": ".release"
    },
    "win": {
      "icon": "dist/favicon.ico"
    },
    "mac": {
      "icon": "dist/favicon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "category": "Utility",
      "icon": "dist/favicon.png",
      "target": "AppImage"
    },
    "files": [
      {
        "from": "dist",
        "to": ""
      },
      {
        "from": "public/assets",
        "to": "assets/"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "giloushaker",
        "repo": "nr-editor",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "gh-pages": "^5.0.0",
    "globals": "^17.11.0",
    "nuxt": "^4.5.2",
    "nuxt-electron": "^0.7.0",
    "nuxt-windicss": "^3.0.1",
    "sass": "^1.62.1",
    "vite": "^8.2.0",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-electron": "^0.11.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^1.8.27"
  },
  "dependencies": {
    "@kyvg/vue3-notification": "^2.9.1",
    "@pinia/nuxt": "^1.0.2",
    "@rollup/plugin-typescript": "^11.1.6",
    "adm-zip": "^0.5.10",
    "chokidar": "^3.5.3",
    "click-outside-vue3": "^4.0.1",
    "dexie": "^3.2.3",
    "electron-updater": "^6.8.9",
    "expr-eval": "^2.0.2",
    "fast-xml-parser": "^4.2.2",
    "jszip": "^3.10.1",
    "lodash.merge": "^4.6.2",
    "mongodb": "^4.16.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "simple-git": "^3.20.0",
    "unzipit": "^1.4.3"
  },
  "prettier": {
    "printWidth": 120,
    "htmlWhitespaceSensitivity": "strict"
  },
  "overrides": {
    "mlly": "^1.8.2"
  }
}
